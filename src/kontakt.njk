extraHead: |
  <style>
  /* Side-unik: hero-bg, kontakt-layout, formular og praktisk info. */
  .hero-bg { background-image: url('/assets/materiale/sabine-smile.jpg'); }
  .hero { min-height: 80vh; }

  /* ========== MAIN CONTENT ========== */
  .main-content { padding: 100px 0; background: var(--sand); }
  .main-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: flex-start;
  }
  .contact-info h2 {
    font-size: clamp(28px, 4vw, 38px);
    font-style: italic;
    color: var(--petrol);
    margin-bottom: 24px;
  }
  .contact-info p {
    font-size: 18px;
    color: var(--text);
    line-height: 1.9;
    margin-bottom: 16px;
  }
  .contact-details { display: flex; flex-direction: column; gap: 18px; margin: 32px 0; }
  .detail-block {
    padding: 20px;
    background: #FFFFFF;
    border-radius: var(--radius);
    border-left: 4px solid var(--gold);
  }
  .detail-label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 8px;
  }
  .detail-content { font-size: 18px; color: var(--text); font-weight: 500; }
  .detail-content a { color: var(--teal); }
  .detail-content a:hover { color: var(--gold); }

  /* ========== FORM ========== */
  .contact-form {
    background: #FFFFFF;
    padding: 40px;
    border-radius: var(--radius);
    box-shadow: 0 8px 32px rgba(0,0,0,0.06);
  }
  .form-intro { font-size: 15px; color: var(--text-dim); margin-bottom: 20px; line-height: 1.6; }
  .form-status { margin-top: 16px; font-size: 15px; line-height: 1.5; min-height: 1.5em; }
  .form-status.is-success { color: var(--teal); }
  .form-status.is-error { color: var(--red); }
  .hp-field { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .form-group { margin-bottom: 24px; }
  .form-group label {
    display: block;
    font-size: 16px;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 8px;
  }
  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid rgba(30, 61, 64, 0.2);
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--text);
    transition: var(--transition);
  }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--gold);
    background: rgba(212, 175, 55, 0.04);
  }
  .form-group textarea { resize: vertical; min-height: 120px; font-family: var(--font-body); }
  .form-submit {
    width: 100%;
    padding: 16px;
    background: var(--gold);
    color: var(--petrol);
    border: none;
    border-radius: 6px;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: var(--transition);
  }
  .form-submit:hover {
    background: var(--gold-light);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(212, 175, 55, 0.3);
  }
  .form-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; box-shadow: none; }

  /* ========== BOOKING EMBED (Cal.com — kun aktiv hvis site.booking.calcom) ========== */
  .booking-embed-section { padding: 80px 0; background: var(--sand-light); }
  .booking-embed-header { text-align: center; margin-bottom: 40px; max-width: 640px; margin-left: auto; margin-right: auto; }
  .booking-embed-header h2 {
    font-size: clamp(28px, 4vw, 38px);
    font-style: italic;
    color: var(--petrol);
    margin-bottom: 16px;
  }
  .booking-embed-header p { font-size: 17px; color: var(--text); }
  .cal-embed {
    background: #FFFFFF;
    border-radius: var(--radius);
    min-height: 600px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.06);
    overflow: hidden;
  }

  /* ========== PRACTICAL INFO ========== */
  .practical-section { padding: 100px 0; background: #FFFFFF; }
  .practical-header { text-align: center; margin-bottom: 48px; }
  .practical-header h2 { font-size: clamp(28px, 4vw, 42px); font-style: italic; margin-bottom: 16px; }
  .practical-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 40px; }
  .practical-card { padding: 40px; background: var(--sand-light); border-radius: var(--radius); }
  .practical-card h3 { font-size: 22px; font-style: italic; margin-bottom: 16px; color: var(--petrol); }
  .practical-card p { font-size: 18px; color: var(--text); line-height: 1.9; }
  .practical-card ul { font-size: 18px; color: var(--text); margin-top: 16px; padding-left: 20px; }
  .practical-card li { margin-bottom: 10px; line-height: 1.8; }

  @media (max-width: 960px) {
    .main-inner { grid-template-columns: 1fr; }
    .practical-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 680px) {
    .practical-card { padding: 24px; }
    .contact-form { padding: 24px; }
  }
  </style>
extraScripts: |
  <script>
  (function () {
    var form = document.querySelector('.contact-form form');
    if (!form) return;

    var status = document.getElementById('formStatus');
    var submitBtn = form.querySelector('button[type="submit"]');
    // form.action er sat til Formspree-URL hvis konfigureret; ellers tom -> mailto-fallback.
    var endpoint = form.getAttribute('data-endpoint') || '';

    function announce(msg, isError) {
      if (!status) return;
      status.textContent = msg;
      status.classList.toggle('is-error', !!isError);
      status.classList.toggle('is-success', !isError);
    }

    function lockSubmit(text) {
      if (!submitBtn) return;
      submitBtn.disabled = true;
      submitBtn.textContent = text;
    }

    function unlockSubmit() {
      if (!submitBtn) return;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send besked';
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();

      // Honeypot — bots fill hidden fields, humans don't.
      var hp = form.querySelector('input[name="company"]');
      if (hp && hp.value) {
        announce('Tak. Beskeden blev modtaget.', false);
        form.reset();
        return;
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      var name = document.getElementById('name').value.trim();
      var email = document.getElementById('email').value.trim();
      var phone = document.getElementById('phone').value.trim();
      var message = document.getElementById('message').value.trim();

      // Branch 1: Ægte backend (Formspree el. lign.) — async fetch, ingen redirect.
      if (endpoint) {
        lockSubmit('Sender …');
        var data = new FormData();
        data.append('name', name);
        data.append('email', email);
        data.append('phone', phone);
        data.append('message', message);
        data.append('_subject', 'Ny besked fra: ' + name);

        fetch(endpoint, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' }
        })
          .then(function (r) {
            if (!r.ok) throw new Error('HTTP ' + r.status);
            return r.json().catch(function () { return {}; });
          })
          .then(function () {
            announce('Tak — din besked er sendt. Jeg vender tilbage hurtigst muligt.', false);
            form.reset();
            lockSubmit('Sendt');
          })
          .catch(function () {
            announce('Beskeden kunne ikke afsendes. Prøv igen, eller ring +45 4112 0149.', true);
            unlockSubmit();
          });
        return;
      }

      // Branch 2: Mailto-fallback — åbner brugerens email-klient.
      var subject = encodeURIComponent('Ny besked fra: ' + name);
      var body = encodeURIComponent(
        'Navn: ' + name + '\n' +
        'Email: ' + email + '\n' +
        'Telefon: ' + phone + '\n' +
        '\nBesked:\n' + message
      );
      window.location.href = 'mailto:sabinelindeberg@hotmail.com?subject=' + subject + '&body=' + body;
      announce('Tak — din emailklient åbner nu. Hvis ikke, ring '
        + '+45 4112 0149 eller skriv til sabinelindeberg@hotmail.com.', false);
      lockSubmit('Sendt');
    });
  })();
  </script>
