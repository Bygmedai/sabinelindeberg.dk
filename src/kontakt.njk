  /* ========== RESPONSIVE ========== */
  @media (max-width: 960px) {
    .main-inner { grid-template-columns: 1fr; }
    .practical-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 680px) {
    .practical-card { padding: 24px; }
    .contact-form { padding: 24px; }
  }

  /* FE6: View Transitions */
  @view-transition { navigation: auto; }
  ::view-transition-old(root) { animation: vt-fade-out 0.25s ease; }
  ::view-transition-new(root) { animation: vt-fade-in 0.25s ease; }
  @keyframes vt-fade-out { to { opacity: 0; } }
  @keyframes vt-fade-in { from { opacity: 0; } }
  </style>
extraScripts: |
  <script>
  // Simple form handling with mailto
  const form = document.querySelector('.contact-form form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('name').value;
      const email = document.getElementById('email').value;
      const phone = document.getElementById('phone').value;
      const message = document.getElementById('message').value;

      const subject = encodeURIComponent('Ny besked fra: ' + name);
      const body = encodeURIComponent(
        'Navn: ' + name + '\n' +
        'Email: ' + email + '\n' +
        'Telefon: ' + phone + '\n' +
        '\nBesked:\n' + message
      );

      window.location.href = 'mailto:sabinelindeberg@hotmail.com?subject=' + subject + '&body=' + body;
    });
  }
  </script>
