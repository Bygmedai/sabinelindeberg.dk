<!-- ========== HERO ========== -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-gradient"></div>

  <div class="container">
    <div class="hero-content">
      <span class="hero-label">Kom i kontakt</span>
      <h1>Booking & Kontakt</h1>
      <p class="hero-tagline">Skriv, ring eller book direkte online</p>
    </div>
  </div>
</section>

{% if site.booking.calcom %}
<!-- ========== CAL.COM BOOKING (kun aktiv når site.booking.calcom er sat) ========== -->
<section class="booking-embed-section" aria-labelledby="bookingHeading">
  <div class="container" data-reveal>
    <div class="booking-embed-header">
      <span class="section-label">Selvbetjent booking</span>
      <h2 id="bookingHeading">Vælg en tid der passer dig</h2>
      <p>Find en ledig tid direkte i kalenderen — eller fortsæt til kontaktformularen længere nede.</p>
    </div>
    <div id="cal-booking-placeholder"
         class="cal-embed"
         data-cal-namespace="{{ site.booking.calcom }}"
         aria-busy="true">
      <noscript>
        <p>Aktivér JavaScript for at se booking-kalenderen, eller
          <a href="https://cal.com/{{ site.booking.calcom }}" target="_blank" rel="noopener">
            book direkte hos Cal.com
          </a>.
        </p>
      </noscript>
    </div>
  </div>
</section>
<script>
// Cal.com inline-embed — lazy-loadet når sektionen scrolles ind.
(function () {
  var slot = document.getElementById('cal-booking-placeholder');
  if (!slot || !('IntersectionObserver' in window)) return;
  var ns = slot.getAttribute('data-cal-namespace');
  if (!ns) return;

  var loaded = false;
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting || loaded) return;
      loaded = true;
      io.disconnect();
      // Cal.com officielle embed-snippet (https://cal.com/docs/embeds)
      (function (C, A, L) {
        var p = function (a, ar) { a.q.push(ar); };
        var d = C.document;
        C.Cal = C.Cal || function () {
          var cal = C.Cal, ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            var api = function () { p(api, arguments); };
            var namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      Cal("init", ns, { origin: "https://cal.com" });
      Cal.ns[ns]("inline", {
        elementOrSelector: "#cal-booking-placeholder",
        config: { layout: "month_view", theme: "light" },
        calLink: ns
      });
      Cal.ns[ns]("ui", {
        cssVarsPerTheme: {
          light: { "cal-brand": "#D4AF37" }
        },
        hideEventTypeDetails: false,
        layout: "month_view"
      });
      slot.removeAttribute('aria-busy');
    });
  }, { rootMargin: '200px' });

  io.observe(slot);
})();
</script>
{% endif %}

<!-- ========== MAIN CONTENT ========== -->
<section class="main-content">
  <div class="container">
    <div class="main-inner" data-reveal>
      <div class="contact-info">
        <span class="section-label">Sådan når du mig</span>
        <h2>Kontakt mig direkte</h2>
        <p>
          Du kan kontakte mig via email, telefon eller kontaktformularen til højre.
          Jeg vender tilbage hurtigst muligt — typisk inden for 24 timer.
        </p>
        <div class="contact-details">
          <div class="detail-block">
            <div class="detail-label">Telefon</div>
            <div class="detail-content">
              <a href="tel:{{ site.phoneE164 }}">{{ site.phone }}</a>
            </div>
          </div>
          <div class="detail-block">
            <div class="detail-label">Email</div>
            <div class="detail-content">
              <a href="mailto:{{ site.email }}">{{ site.email }}</a>
            </div>
          </div>
          <div class="detail-block">
            <div class="detail-label">Lokation</div>
            <div class="detail-content">{{ site.address.locality }}, Danmark</div>
          </div>
          <div class="detail-block">
            <div class="detail-label">Priser</div>
            <div class="detail-content">{{ site.prices.summary }}</div>
          </div>
          <div class="detail-block">
            <div class="detail-label">Sessionslængde</div>
            <div class="detail-content">{{ site.session.duration }}</div>
          </div>
          <div class="detail-block">
            <div class="detail-label">Åbningstider</div>
            <div class="detail-content">{{ site.openingHoursDisplay }}</div>
          </div>
          <div class="detail-block">
            <div class="detail-label">Format</div>
            <div class="detail-content">{{ site.session.format }}</div>
          </div>
        </div>
      </div>

      <div class="contact-form">
        <h3 style="font-size: 20px; margin-bottom: 24px; color: var(--petrol);">Send en besked</h3>
        <p id="formIntro" class="form-intro">
          Felter markeret med <span aria-hidden="true">*</span><span class="sr-only">stjerne</span> er obligatoriske.
          Beskeden åbnes i din emailklient — så du selv afsender og har en kopi.
        </p>
        <form aria-describedby="formIntro" novalidate{% if site.forms.endpoint %} action="{{ site.forms.endpoint }}" method="POST" data-endpoint="{{ site.forms.endpoint }}"{% endif %}>
          <div class="form-group">
            <label for="name">Dit navn <span aria-hidden="true">*</span></label>
            <input type="text" id="name" name="name" autocomplete="name" required>
          </div>
          <div class="form-group">
            <label for="email">Din email <span aria-hidden="true">*</span></label>
            <input type="email" id="email" name="email" autocomplete="email" inputmode="email" required>
          </div>
          <div class="form-group">
            <label for="phone">Telefonnummer (valgfrit)</label>
            <input type="tel" id="phone" name="phone" autocomplete="tel" inputmode="tel">
          </div>
          <div class="form-group">
            <label for="message">Din besked <span aria-hidden="true">*</span></label>
            <textarea id="message" name="message" rows="5" required></textarea>
          </div>
          <!-- Honeypot — visually hidden, off-screen, off-tab, ignored by users. -->
          <div class="hp-field" aria-hidden="true">
            <label for="company">Virksomhed (lad være tom)</label>
            <input type="text" id="company" name="company" tabindex="-1" autocomplete="off">
          </div>
          <button type="submit" class="form-submit">Send besked</button>
          <p id="formStatus" class="form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- ========== PRACTICAL INFO ========== -->
<section class="practical-section">
  <div class="container">
    <div class="practical-header" data-reveal>
      <span class="section-label">Praktisk information</span>
      <h2>Det er godt at vide</h2>
    </div>
    <div class="practical-grid">
      <div class="practical-card" data-reveal>
        <h3>Afklarende samtale</h3>
        <p>
          Hvis du er usikker på, hvad der er det rigtige for dig, kan du starte med en afklarende samtale.
          Det er en mulighed til at mødes, at I kan høre hinanden, og til at finde ud af,
          hvordan vi bedst kan arbejde sammen.
        </p>
      </div>

      <div class="practical-card" data-reveal>
        <h3>Sessionslængde</h3>
        <p>
          En session varer typisk 60–90 minutter. De fleste oplever, at sessioner med hypnoseterapi
          virker mest effektivt som en serie på 3-5 gange. Terapeutiske samtaler kan være enkelte
          eller løbende.
        </p>
      </div>

      <div class="practical-card" data-reveal>
        <h3>Online eller in-person</h3>
        <p>
          Du kan mødes med mig i mine behandlerlokaler i Frederikssund eller online via video.
          Begge formats virker lige godt. Vælg det, der passer bedst til dig.
        </p>
      </div>

      <div class="practical-card" data-reveal>
        <h3>Betingelser</h3>
        <p>
          Jeg arbejder med tillid og åbenhed. Hvis du ikke føler jer tryg ved hypnoseterapi
          eller blot gerne vil have samtale i stedet, er det helt i orden.
          Vi kan altid justere efter dine behov.
        </p>
      </div>
    </div>
  </div>
</section>
