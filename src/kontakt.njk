  .practical-card {
    padding: 40px;
    background: var(--sand-light);
    border-radius: var(--radius);
  }

  .practical-card h3 {
    font-size: 22px;
    font-style: italic;
    margin-bottom: 16px;
    color: var(--petrol);
  }

  .practical-card p {
    font-size: 18px;
    color: var(--text);
    line-height: 1.9;
  }

  .practical-card ul {
    font-size: 18px;
    color: var(--text);
