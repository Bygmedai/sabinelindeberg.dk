{#
  critical-css.njk — inlines ~5 KB above-the-fold CSS i <head>.

  Indeholdt:
    - CSS reset
    - Design tokens (komplet skin overrides)
    - Layout-utilities (.container)
    - Skip-link
    - Focus-visible
    - Nav (komplet — synlig på alle sider)
    - Hero base-mønster (synlig som første sektion på alle sider)
    - GDPR-banner skelet (hvis vist)
    - prefers-reduced-motion guard

  Resten af CSS (intro, content-section, cta-section, footer-styles m.v.)
  loades async via preload+onload-pattern i head.njk.

  Designtokens er inlinede her som hardcodede værdier — synced med
  src/assets/css/skins/sabinelindeberg.css. Hvis Sabines farver ændres,
  skal begge filer opdateres. Set som acceptabel trade-off for at fjerne
  render-blocking eksterne CSS-filer.
#}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:hidden}
body{font-family:'Jost',-apple-system,sans-serif;background:#FFFFFF;color:#1A1A1A;font-size:18px;line-height:1.7;overflow-x:hidden;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}
img{max-width:100%;display:block}
a{color:#2E5A57;text-decoration:none;transition:0.4s cubic-bezier(0.25,0.46,0.45,0.94)}
a:hover{color:#D4AF37}
h1,h2,h3,h4{font-family:'Cormorant Garamond',Georgia,serif;font-weight:500;line-height:1.25;color:#1E3D40}

:root{
  --black:#FFFFFF;--black-light:#F7F4EF;
  --pink:#D4AF37;--pink-light:#E8CC6E;
  --orange:#D4AF37;--orange-hover:#E8CC6E;
  --petrol:#1E3D40;--petrol-deep:#162E30;--petrol-rgb:30,61,64;
  --gold:#D4AF37;--gold-light:#E8CC6E;--gold-soft:rgba(212,175,55,0.12);
  --sand:#F1ECE4;--sand-light:#F7F4EF;
  --teal:#2E5A57;--teal-light:#3A706C;
  --gradient:linear-gradient(135deg,#D4AF37,#2E5A57);
  --gradient-subtle:linear-gradient(135deg,rgba(212,175,55,0.15),rgba(46,90,87,0.15));
  --text:#1A1A1A;--text-muted:#333;--text-dim:#666;
  --nav-border:rgba(212,175,55,0.2);
  --radius:12px;--max-w:1100px;
  --transition:0.4s cubic-bezier(0.25,0.46,0.45,0.94);
  --bg:#FFFFFF;--surface:#F7F4EF;
  --accent:#D4AF37;--accent-light:#E8CC6E;--accent-bg:rgba(212,175,55,0.1);
  --navy:#1E3D40;--navy-light:#2E5A57;
  --warm:#D4AF37;--white:#FFFFFF;--blue:#F7F4EF;
  --green:#2E5A57;--grey:#666;--red:#C44536;
  --font-display:'Cormorant Garamond',Georgia,serif;
  --font-body:'Jost',-apple-system,sans-serif;
}

.container{max-width:var(--max-w);margin:0 auto;padding:0 24px}
.sr-only,.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

.skip-link{position:absolute;top:-40px;left:8px;z-index:1000;padding:10px 16px;background:#D4AF37;color:#1E3D40;font-family:var(--font-body);font-weight:600;border-radius:6px;text-decoration:none;transition:top 0.2s ease}
.skip-link:focus{top:8px;outline:2px solid #1E3D40;outline-offset:2px}

:focus-visible{outline:2px solid #D4AF37;outline-offset:3px;border-radius:4px}
:focus:not(:focus-visible){outline:none}

nav{position:fixed;top:0;left:0;right:0;z-index:100;background:rgba(30,61,64,0.97);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:1px solid var(--nav-border);transition:var(--transition)}
nav .container{display:flex;align-items:center;justify-content:space-between;height:72px}
.nav-brand{display:flex;align-items:center;gap:12px}
.nav-logo-img{height:44px;width:auto}
.nav-logo-text{font-family:var(--font-display);font-size:20px;font-weight:600;color:#D4AF37;letter-spacing:0.5px;line-height:1.2}
.nav-links{display:flex;gap:24px;list-style:none;align-items:center}
.nav-links a{color:rgba(255,255,255,0.85);font-size:15px;font-weight:400;letter-spacing:0.3px;transition:var(--transition)}
.nav-links a:hover{color:#D4AF37}
.nav-cta{background:#D4AF37!important;color:#1E3D40!important;padding:9px 22px;border-radius:6px;font-weight:500!important}
.nav-cta:hover{background:#E8CC6E!important;transform:translateY(-1px)}
.hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:6px}
.hamburger span{display:block;width:26px;height:2px;background:#D4AF37;border-radius:2px;transition:var(--transition)}
.hamburger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.hamburger[aria-expanded="true"] span:nth-child(2){opacity:0}
.hamburger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}
.nav-links a[aria-current="page"]{color:#D4AF37}
.nav-links a.nav-cta[aria-current="page"]{color:#1E3D40!important}

.hero{position:relative;min-height:80vh;display:flex;align-items:center;background:#1E3D40;overflow:hidden;padding-top:72px}
.hero-bg{position:absolute;top:0;left:0;right:0;bottom:0;background-position:center;background-size:cover;background-repeat:no-repeat;opacity:0.15;filter:blur(1px)}
.hero-gradient{position:absolute;bottom:0;left:0;right:0;height:250px;background:linear-gradient(to top,#1E3D40,transparent)}
.hero-content{position:relative;z-index:2}
.hero h1{font-size:clamp(40px,6vw,62px);font-weight:400;color:#FFFFFF;margin-bottom:10px;font-style:italic}

.btn{display:inline-block;padding:15px 36px;border-radius:6px;font-family:var(--font-body);font-size:16px;font-weight:500;letter-spacing:0.5px;transition:var(--transition);cursor:pointer;border:none}
.btn-gold{background:var(--gold);color:var(--petrol)}
.btn-gold:hover{background:var(--gold-light);color:var(--petrol);transform:translateY(-2px);box-shadow:0 8px 24px rgba(212,175,55,0.3)}
.btn-outline{background:transparent;color:var(--gold);border:1px solid rgba(212,175,55,0.4)}
.btn-outline:hover{border-color:var(--gold);background:rgba(212,175,55,0.08);color:var(--gold)}
.btn-teal{background:var(--teal);color:#FFFFFF}
.btn-teal:hover{background:var(--teal-light);color:#FFFFFF;transform:translateY(-2px)}

@media (max-width:680px){
  body{font-size:17px}
  .nav-links{display:none}
  .hamburger{display:flex}
}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:0.01ms!important;animation-iteration-count:1!important;transition-duration:0.01ms!important}
}
