<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
{% include "partials/head.njk" %}
<style>
/* ============================================================
   Sabine Lindeberg — Lag 2 (nav, footer, shared components)
   Site-specific tokens are in /assets/css/skins/sabinelindeberg.css
   ============================================================ */

/* ========== NAVIGATION ========== */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(var(--petrol-rgb), 0.97);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--nav-border);
  transition: var(--transition);
}

nav .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nav-logo-img {
  height: 44px;
  width: auto;
}

.nav-logo-text {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.5px;
  line-height: 1.2;
}

.nav-links {
  display: flex;
  gap: 24px;
  list-style: none;
  align-items: center;
}

.nav-links a {
  color: rgba(255,255,255,0.85);
  font-size: 15px;
  font-weight: 400;
  letter-spacing: 0.3px;
  transition: var(--transition);
}

.nav-links a:hover { color: var(--gold); }

.nav-cta {
  background: var(--gold) !important;
  color: var(--petrol) !important;
  padding: 9px 22px;
  border-radius: 6px;
  font-weight: 500 !important;
}

.nav-cta:hover {
  background: var(--gold-light) !important;
  transform: translateY(-1px);
}

.hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 6px; }
.hamburger span { display: block; width: 26px; height: 2px; background: var(--gold); border-radius: 2px; transition: var(--transition); }
.hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* Active link indicator */
.nav-links a[aria-current="page"] { color: var(--gold); }
.nav-links a.nav-cta[aria-current="page"] { color: var(--petrol) !important; }

/* ========== GDPR CONSENT BANNER ========== */
.gdpr-consent {
  position: fixed;
  bottom: 16px; left: 16px; right: 16px;
  z-index: 200;
  max-width: 540px;
  margin: 0 auto;
  padding: 18px 20px;
  background: var(--petrol);
  color: rgba(255,255,255,0.92);
  border: 1px solid rgba(212,175,55,0.4);
  border-radius: 10px;
  box-shadow: 0 12px 40px rgba(0,0,0,0.25);
  display: none;
  font-size: 14px;
  line-height: 1.55;
}
.gdpr-consent.is-open { display: block; }
.gdpr-consent p { margin: 0 0 12px; }
.gdpr-consent a { color: var(--gold); text-decoration: underline; }
.gdpr-consent-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.gdpr-btn {
  flex: 1 1 auto;
  padding: 10px 16px;
  border: 1px solid rgba(212,175,55,0.5);
  background: transparent;
  color: rgba(255,255,255,0.92);
  border-radius: 6px;
  cursor: pointer;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 500;
  transition: var(--transition);
}
.gdpr-btn:hover { border-color: var(--gold); }
.gdpr-btn.is-primary { background: var(--gold); color: var(--petrol); border-color: var(--gold); }
.gdpr-btn.is-primary:hover { background: var(--gold-light); }

/* ========== GOLD SWOOSH DIVIDER ========== */
.gold-swoosh {
  position: relative;
  height: 48px;
  overflow: hidden;
  background: transparent;
}

.gold-swoosh svg {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 100%;
}

/* ========== FOOTER ========== */
footer {
  padding: 64px 0 40px;
  background: var(--petrol-deep);
  color: rgba(255,255,255,0.7);
}

.footer-inner {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 48px;
  margin-bottom: 48px;
}

.footer-brand-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}

.footer-brand-logo img { height: 36px; }

.footer-brand-logo span {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 600;
  color: var(--gold);
}

.footer-brand p {
  font-size: 16px;
  line-height: 1.75;
  max-width: 300px;
}

footer h4 {
  font-size: 13px;
  font-family: var(--font-body);
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 20px;
}

.footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-links a {
  color: rgba(255,255,255,0.65);
  font-size: 16px;
}

.footer-links a:hover { color: var(--gold); }

.footer-contact-item {
  font-size: 16px;
  margin-bottom: 8px;
}

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.08);
  padding-top: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
}

.bygmedai-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: rgba(255,255,255,0.3);
  font-size: 12px;
}

.bygmedai-badge a { color: rgba(255,255,255,0.4); }
.bygmedai-badge a:hover { color: var(--gold); }

/* ========== RESPONSIVE (shared) ========== */
@media (max-width: 960px) {
  .footer-inner { grid-template-columns: 1fr; text-align: center; }
  .footer-brand p { margin: 0 auto; }
  .footer-bottom { flex-direction: column; gap: 12px; }
}

@media (max-width: 680px) {
  body { font-size: 17px; }
  .nav-links { display: none; }
  .hamburger { display: flex; }
  .nav-links.open {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: 72px; left: 0; right: 0;
    background: var(--petrol);
    padding: 24px;
    gap: 16px;
    border-bottom: 1px solid rgba(212,175,55,0.15);
  }
}

@media (prefers-reduced-motion: reduce) {
  [data-reveal], .stagger-item {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
</style>
</head>
<body>
<a class="skip-link" href="#main">Spring til hovedindhold</a>

{% include "partials/nav.njk" %}

<main id="main" tabindex="-1">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

{% if site.ga4 %}
<aside class="gdpr-consent" id="gdprConsent" role="dialog" aria-labelledby="gdprTitle" aria-describedby="gdprDesc">
  <p id="gdprTitle"><strong>Cookies & analyse</strong></p>
  <p id="gdprDesc">
    Sitet bruger Google Analytics til anonym statistik. Du kan altid takke nej —
    så indlæses sporing slet ikke. <a href="/kontakt/">Kontakt</a> hvis du har spørgsmål.
  </p>
  <div class="gdpr-consent-actions">
    <button type="button" class="gdpr-btn" id="gdprDecline">Nej tak</button>
    <button type="button" class="gdpr-btn is-primary" id="gdprAccept">Jeg accepterer</button>
  </div>
</aside>
{% endif %}

{% if jsonLd %}
<script type="application/ld+json">{{ jsonLd | safe }}</script>
{% endif %}

{{ extraScripts | safe }}

<script>
// Scroll reveal
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('revealed');
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));

// Stagger items
document.querySelectorAll('[data-stagger]').forEach(group => {
  const items = group.querySelectorAll('.stagger-item');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        items.forEach((item, i) => {
          setTimeout(() => item.classList.add('revealed'), i * 120);
        });
        obs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  obs.observe(group);
});

// Accessible mobile nav toggle (replaces inline onclick)
(function () {
  var btn = document.getElementById('navToggle');
  var menu = document.getElementById('navLinks');
  if (!btn || !menu) return;

  function setOpen(open) {
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    btn.setAttribute('aria-label', open ? 'Luk menu' : 'Åbn menu');
    menu.classList.toggle('open', open);
  }

  btn.addEventListener('click', function () {
    setOpen(btn.getAttribute('aria-expanded') !== 'true');
  });

  // Close on Escape
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      btn.focus();
    }
  });

  // Close when a link is activated (so mobile menu collapses on navigation)
  menu.addEventListener('click', function (e) {
    if (e.target.closest('a')) setOpen(false);
  });

  // Navbar background tint on scroll (replaces per-page inline scroll handler)
  var navEl = document.querySelector('nav');
  if (navEl) {
    var update = function () {
      navEl.style.background = window.scrollY > 100
        ? 'rgba(22, 46, 48, 0.98)'
        : 'rgba(30, 61, 64, 0.97)';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
})();

{% if site.ga4 %}
// GDPR consent banner
(function () {
  var banner = document.getElementById('gdprConsent');
  if (!banner) return;
  if (window.__slConsentStored !== 'granted' && window.__slConsentStored !== 'denied') {
    banner.classList.add('is-open');
  }
  var accept = document.getElementById('gdprAccept');
  var decline = document.getElementById('gdprDecline');
  if (accept) accept.addEventListener('click', function () {
    if (window.__slGrantConsent) window.__slGrantConsent();
    banner.classList.remove('is-open');
  });
  if (decline) decline.addEventListener('click', function () {
    if (window.__slDeclineConsent) window.__slDeclineConsent();
    banner.classList.remove('is-open');
  });
})();
{% endif %}
</script>
</body>
</html>
