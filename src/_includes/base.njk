<!DOCTYPE html>
<html lang="{{ site.lang }}">
<head>
{% include "partials/head.njk" %}
<style>
/* ============================================================
   Sabine Lindeberg — Lag 2 (nav, footer, shared components)
   Site-specific tokens are in /assets/css/skins/sabinelindeberg.css
   ============================================================ */

/* ========== NAVIGATION ========== */
nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(var(--petrol-rgb), 0.97);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--nav-border);
  transition: var(--transition);
}

nav .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nav-logo-img {
  height: 44px;
  width: auto;
}

.nav-logo-text {
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: 600;
  color: var(--gold);
  letter-spacing: 0.5px;
  line-height: 1.2;
}

.nav-links {
  display: flex;
  gap: 24px;
  list-style: none;
  align-items: center;
}

.nav-links a {
  color: rgba(255,255,255,0.85);
  font-size: 15px;
  font-weight: 400;
  letter-spacing: 0.3px;
  transition: var(--transition);
}

.nav-links a:hover { color: var(--gold); }

.nav-cta {
  background: var(--gold) !important;
  color: var(--petrol) !important;
  padding: 9px 22px;
  border-radius: 6px;
  font-weight: 500 !important;
}

.nav-cta:hover {
  background: var(--gold-light) !important;
  transform: translateY(-1px);
}

.hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 6px; }
.hamburger span { display: block; width: 26px; height: 2px; background: var(--gold); border-radius: 2px; transition: var(--transition); }

/* ========== GOLD SWOOSH DIVIDER ========== */
.gold-swoosh {
  position: relative;
  height: 48px;
  overflow: hidden;
  background: transparent;
}

.gold-swoosh svg {
  position: absolute;
  bottom: 0;
  width: 100%;
  height: 100%;
}

/* ========== FOOTER ========== */
footer {
  padding: 64px 0 40px;
  background: var(--petrol-deep);
  color: rgba(255,255,255,0.7);
}

.footer-inner {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr;
  gap: 48px;
  margin-bottom: 48px;
}

.footer-brand-logo {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}

.footer-brand-logo img { height: 36px; }

.footer-brand-logo span {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 600;
  color: var(--gold);
}

.footer-brand p {
  font-size: 16px;
  line-height: 1.75;
  max-width: 300px;
}

footer h4 {
  font-size: 13px;
  font-family: var(--font-body);
  font-weight: 500;
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 20px;
}

.footer-links {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.footer-links a {
  color: rgba(255,255,255,0.65);
  font-size: 16px;
}

.footer-links a:hover { color: var(--gold); }

.footer-contact-item {
  font-size: 16px;
  margin-bottom: 8px;
}

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.08);
  padding-top: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 13px;
}

.bygmedai-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: rgba(255,255,255,0.3);
  font-size: 12px;
}

.bygmedai-badge a { color: rgba(255,255,255,0.4); }
.bygmedai-badge a:hover { color: var(--gold); }

/* ========== RESPONSIVE (shared) ========== */
@media (max-width: 960px) {
  .footer-inner { grid-template-columns: 1fr; text-align: center; }
  .footer-brand p { margin: 0 auto; }
  .footer-bottom { flex-direction: column; gap: 12px; }
}

@media (max-width: 680px) {
  body { font-size: 17px; }
  .nav-links { display: none; }
  .hamburger { display: flex; }
  .nav-links.open {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: 72px; left: 0; right: 0;
    background: var(--petrol);
    padding: 24px;
    gap: 16px;
    border-bottom: 1px solid rgba(212,175,55,0.15);
  }
}

@media (prefers-reduced-motion: reduce) {
  [data-reveal], .stagger-item {
    opacity: 1;
    transform: none;
    transition: none;
  }
}
</style>
</head>
<body>
{% include "partials/nav.njk" %}

{{ content | safe }}

{% include "partials/footer.njk" %}

{% if jsonLd %}
<script type="application/ld+json">{{ jsonLd | safe }}</script>
{% endif %}

{{ extraScripts | safe }}

<script>
// Scroll reveal
const revealObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      entry.target.classList.add('revealed');
      revealObserver.unobserve(entry.target);
    }
  });
}, { threshold: 0.1 });

document.querySelectorAll('[data-reveal]').forEach(el => revealObserver.observe(el));

// Stagger items
document.querySelectorAll('[data-stagger]').forEach(group => {
  const items = group.querySelectorAll('.stagger-item');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        items.forEach((item, i) => {
          setTimeout(() => item.classList.add('revealed'), i * 120);
        });
        obs.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });
  obs.observe(group);
});
</script>
</body>
</html>
