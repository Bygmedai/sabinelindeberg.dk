extraHead: |
  <style>
  /* Side-unik CSS for forsiden. Delte .btn/.section-label/.cta-section
     ligger i components.css. Reveal/stagger ligger i base.css. */

  /* HERO override — forsiden har 2-kolonne grid med portræt */
  .hero { min-height: 100vh; }
  .hero-bg { background-image: url('/assets/materiale/sabine-sne-bred.jpg'); }
  .hero-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    padding: 60px 0;
    text-align: left;
  }
  .hero-text { text-align: left; }
  .hero-tagline { margin-bottom: 28px; }
  .hero-desc {
    font-size: 18px;
    color: rgba(255,255,255,0.8);
    max-width: 480px;
    line-height: 1.85;
    margin-bottom: 36px;
  }
  .hero-photo { position: relative; justify-self: end; align-self: center; }
  .hero-photo img {
    border-radius: var(--radius);
    width: 100%;
    max-width: 210px;
    aspect-ratio: 3/4;
    object-fit: cover;
    object-position: center 20%;
    box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  }
  .hero-photo::after {
    content: '';
    position: absolute;
    bottom: -8px; right: -8px;
    width: 100%; height: 100%;
    border: 1px solid rgba(212, 175, 55, 0.25);
    border-radius: var(--radius);
    z-index: -1;
  }

  /* INTRO pain-points — unikt for forsiden */
  .pain-points {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
    max-width: 480px;
    margin: 32px auto 0;
  }
  .pain-point {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: 18px;
    color: var(--text);
    line-height: 1.6;
  }
  .pain-point::before {
    content: '';
    width: 8px; height: 8px;
    background: var(--gold);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 10px;
  }
  .intro-closing {
    margin-top: 32px;
    font-size: 18px;
    color: var(--text);
    font-style: italic;
  }

  /* SERVICES grid */
  .services { padding: 100px 0; background: #FFFFFF; }
  .services-header { text-align: center; margin-bottom: 56px; }
  .services-header h2 { font-size: clamp(28px, 4vw, 42px); font-style: italic; }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }
  .service-card {
    background: var(--sand-light);
    border-radius: var(--radius);
    padding: 48px 32px 36px;
    text-align: center;
    transition: var(--transition);
    border: 1px solid transparent;
    position: relative;
    overflow: hidden;
  }
  .service-card::before {
    content: '';
    position: absolute;
    top: 0; left: 50%;
    transform: translateX(-50%);
    width: 60px; height: 3px;
    background: var(--gold);
    border-radius: 0 0 4px 4px;
  }
  .service-card:hover {
    border-color: rgba(212, 175, 55, 0.25);
    transform: translateY(-4px);
    box-shadow: 0 12px 36px rgba(30, 61, 64, 0.08);
  }
  .service-icon { font-size: 40px; margin-bottom: 20px; color: var(--gold); }
  .service-card h3 {
    font-size: 26px;
    font-style: italic;
    margin-bottom: 18px;
    color: var(--petrol);
  }
  .service-card p {
    font-size: 17px;
    color: var(--text);
    line-height: 1.8;
    margin-bottom: 22px;
  }
  .card-link {
    font-size: 15px;
    font-weight: 500;
    color: var(--teal);
    letter-spacing: 0.5px;
  }
  .card-link:hover { color: var(--gold); }

  /* PARALLAX NATURE */
  .nature-parallax {
    position: relative;
    height: 400px;
    background: url('/assets/materiale/sabine-natur.jpg') center/cover no-repeat;
    background-attachment: fixed;
  }
  .nature-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(var(--petrol-rgb), 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nature-quote { text-align: center; max-width: 600px; padding: 0 24px; }
  .nature-quote blockquote {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 36px);
    font-style: italic;
    color: #FFFFFF;
    line-height: 1.4;
    margin-bottom: 16px;
  }
  .nature-quote cite {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--gold);
    font-style: normal;
    letter-spacing: 1px;
  }

  /* ABOUT TEASER */
  .about-teaser {
    padding: 100px 0;
    background: var(--petrol);
    position: relative;
    overflow: hidden;
  }
  .about-teaser::before {
    content: '';
    position: absolute;
    top: -50%; right: -20%;
    width: 600px; height: 600px;
    border-radius: 50%;
    border: 1px solid rgba(212, 175, 55, 0.06);
  }
  .about-inner {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 64px;
    align-items: center;
  }
  .about-image { position: relative; }
  .about-image img {
    border-radius: var(--radius);
    width: 100%;
    aspect-ratio: 3/4;
    object-fit: cover;
  }
  .about-image::after {
    content: '';
    position: absolute;
    bottom: -12px; right: -12px;
    width: 100%; height: 100%;
    border: 1px solid rgba(212, 175, 55, 0.15);
    border-radius: var(--radius);
    z-index: -1;
  }
  .about-text h2 {
    font-size: clamp(28px, 4vw, 38px);
    font-style: italic;
    color: #FFFFFF;
    margin-bottom: 24px;
  }
  .about-text p {
    font-size: 18px;
    color: rgba(255,255,255,0.85);
    line-height: 1.9;
    margin-bottom: 16px;
  }
  .about-methods {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 28px 0 36px;
  }
  .about-method {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 17px;
    color: rgba(255,255,255,0.8);
  }
  .about-method::before {
    content: '';
    width: 24px; height: 1px;
    background: var(--gold);
    flex-shrink: 0;
  }

  /* BOOKING TEASER */
  .booking-teaser { padding: 80px 0; background: var(--sand); }
  .booking-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .booking-info h2 {
    font-size: clamp(26px, 3.5vw, 36px);
    font-style: italic;
    margin-bottom: 20px;
    color: var(--petrol);
  }
  .booking-info p {
    font-size: 18px;
    color: var(--text);
    line-height: 1.85;
    margin-bottom: 16px;
  }
  .booking-details {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 28px 0;
  }
  .booking-detail {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 17px;
    color: var(--text);
  }
  .booking-detail-icon {
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--gold-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
  }

  /* RESPONSIVE override (forside-specifikt) */
  @media (max-width: 960px) {
    .hero-content { grid-template-columns: 1fr; text-align: center; gap: 40px; }
    .hero-photo { order: -1; }
    .hero-photo img { margin: 0 auto; max-width: 180px; }
    .hero-desc { margin: 0 auto 36px; }
    .services-grid { grid-template-columns: 1fr; max-width: 500px; margin: 0 auto; }
    .about-inner { grid-template-columns: 1fr; text-align: center; }
    .about-image { max-width: 380px; margin: 0 auto; }
    .about-methods { align-items: center; }
    .booking-inner { grid-template-columns: 1fr; }
    .nature-parallax { background-attachment: scroll; }
  }
  @media (max-width: 680px) {
    .hero-photo img { max-width: 160px; }
  }
  </style>
---

<!-- ========== HERO ========== -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="hero-gradient"></div>

  <svg class="hero-swoosh" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
    <path d="M0 80 C300 20, 600 100, 900 40 C1100 0, 1300 60, 1500 30" stroke="#D4AF37" stroke-width="2" fill="none"/>
    <path d="M0 90 C350 30, 650 110, 950 50 C1150 10, 1350 70, 1500 40" stroke="#D4AF37" stroke-width="1" fill="none" opacity="0.4"/>
  </svg>

  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <img src="/assets/materiale/logo-tree.png" alt="" aria-hidden="true" class="hero-logo" width="120" height="120" decoding="async" style="width: 120px; height: 120px; margin-bottom: 1.2rem; filter: drop-shadow(0 2px 8px rgba(212,175,55,0.3));">
        <span class="hero-label">Hypnoseterapi · Samtale · Shamanistiske Cirkler</span>
        <h1>Indre Kald og Kraft</h1>
        <p class="hero-tagline">ved Sabine Lindeberg</p>
        <p class="hero-desc">
          Savner du klarhed og retning i dit liv? Måske kan du mærke, at noget i dig kalder på forandring — men det er ikke helt tydeligt endnu, hvad næste skridt er.
        </p>
        <a href="/kontakt/" class="btn btn-gold">Book en samtale</a>
      </div>
      <div class="hero-photo" data-reveal>
        <picture>
          <source srcset="/assets/materiale/sabine-portrait.avif" type="image/avif">
          <source srcset="/assets/materiale/sabine-portrait.webp" type="image/webp">
          <img src="/assets/materiale/sabine-portrait.jpg" alt="Sabine Lindeberg — terapeut og hypnoterapeut" width="420" height="560" fetchpriority="high" decoding="async">
        </picture>
      </div>
    </div>
  </div>
</section>

<!-- ========== INTRO ========== -->
<section class="intro">
  <div class="container">
    <div class="intro-inner" data-reveal>
      <span class="section-label">Et trygt rum</span>
      <h2>Find ro, klarhed og kontakt til din egen indre kraft</h2>
      <p>Mange mennesker oplever perioder i livet, hvor de føler sig fastlåste i gamle tankemønstre eller handlemønstre. Det kan vise sig som:</p>
      <div class="pain-points">
        <div class="pain-point">Overtænkning og indre uro</div>
        <div class="pain-point">Tvivl om hvilken retning man skal vælge</div>
        <div class="pain-point">Følelsen af at stå i vejen for sig selv</div>
        <div class="pain-point">Længsel efter et mere ægte og meningsfuldt liv</div>
      </div>
      <p class="intro-closing">Hos mig arbejder vi med at skabe klarhed, slippe det der holder dig tilbage, og finde frem til det, der er rigtigt for dig.</p>
    </div>
  </div>
</section>

<!-- ========== SERVICES ========== -->
<section class="services">
  <div class="container">
    <div class="services-header" data-reveal>
      <span class="section-label">Mine ydelser</span>
      <h2>Tre veje til forandring</h2>
    </div>
    <div class="services-grid">
      <div class="service-card stagger-item">
        <div class="service-icon" aria-hidden="true">✦</div>
        <h3>Hypnoseterapi</h3>
        <p>En nænsom og effektiv metode til at arbejde med de dybere lag i sindet — dér hvor mange af vores mønstre og reaktioner er formet.</p>
        <a href="/hypnoseterapi/" class="card-link" aria-label="Læs mere om hypnoseterapi">Læs mere →</a>
      </div>
      <div class="service-card stagger-item">
        <div class="service-icon" aria-hidden="true">❋</div>
        <h3>Terapeutisk samtale</h3>
        <p>Gennem samtale og refleksion arbejder vi med livsafklaring, relationer, valg og retning i livet. Et sted at tænke højt og blive mødt med ro.</p>
        <a href="/terapeutisk-samtale/" class="card-link" aria-label="Læs mere om terapeutisk samtale">Læs mere →</a>
      </div>
      <div class="service-card stagger-item">
        <div class="service-icon" aria-hidden="true">◎</div>
        <h3>Shamanistiske cirkler</h3>
        <p>I cirklerne arbejder vi med naturforbindelse, ritual og fællesskab. Gennem kraftsang forbinder vi os til vores egen energi og livskraft.</p>
        <a href="/shamanistiske-cirkler/" class="card-link" aria-label="Læs mere om shamanistiske cirkler">Læs mere →</a>
      </div>
    </div>
  </div>
</section>

<!-- ========== NATURE PARALLAX ========== -->
<section class="nature-parallax">
  <div class="nature-overlay">
    <div class="nature-quote" data-reveal>
      <blockquote>Forandring sker bedst, når vi føler os trygge</blockquote>
      <cite>— Sabine Lindeberg</cite>
    </div>
  </div>
</section>

<!-- ========== ABOUT TEASER ========== -->
<section class="about-teaser">
  <div class="container">
    <div class="about-inner">
      <div class="about-image" data-reveal>
        <img src="/assets/materiale/sabine-sne-portrait.jpg" alt="Sabine Lindeberg i naturen" width="480" height="640" loading="lazy" decoding="async">
      </div>
      <div class="about-text" data-reveal>
        <span class="section-label">Om Sabine</span>
        <h2>Terapi handler om at finde kontakt til din egen sandhed</h2>
        <p>Jeg arbejder med mennesker, der ønsker klarhed, retning og dybere kontakt til sig selv.</p>
        <p>For mig handler terapi ikke kun om at løse problemer — men om at skabe kontakt til det sted i os, hvor vi kan mærke vores egen sandhed og kraft.</p>
        <div class="about-methods">
          <div class="about-method">Hypnoseterapi</div>
          <div class="about-method">Terapeutisk samtale</div>
          <div class="about-method">Shamanistisk praksis</div>
        </div>
        <a href="/om-sabine/" class="btn btn-outline">Læs mere om Sabine</a>
      </div>
    </div>
  </div>
</section>

<!-- ========== BOOKING TEASER ========== -->
<section class="booking-teaser">
  <div class="container">
    <div class="booking-inner" data-reveal>
      <div class="booking-info">
        <span class="section-label">Praktisk info</span>
        <h2>Sessioner i Frederikssund og online</h2>
        <p>Hvis du er i tvivl om, hvad der er det rigtige for dig, kan du starte med en afklarende samtale.</p>
        <div class="booking-details">
          <div class="booking-detail">
            <div class="booking-detail-icon" aria-hidden="true">📞</div>
            <span><a href="tel:{{ site.phoneE164 }}" style="color: inherit; text-decoration: none;">{{ site.phone }}</a></span>
          </div>
          <div class="booking-detail">
            <div class="booking-detail-icon" aria-hidden="true">📍</div>
            <span>Behandlerlokaler i Frederikssund</span>
          </div>
          <div class="booking-detail">
            <div class="booking-detail-icon" aria-hidden="true">💻</div>
            <span>Online sessioner via video</span>
          </div>
          <div class="booking-detail">
            <div class="booking-detail-icon" aria-hidden="true">💰</div>
            <span>{{ site.prices.summary }}</span>
          </div>
          <div class="booking-detail">
            <div class="booking-detail-icon" aria-hidden="true">⏱</div>
            <span>En session varer typisk {{ site.session.duration }}</span>
          </div>
        </div>
        <a href="/kontakt/" class="btn btn-teal">Book en samtale</a>
      </div>
      <div class="booking-image">
        <img src="/assets/materiale/sabine-smile.jpg" alt="Sabine Lindeberg" width="380" height="507" style="border-radius: var(--radius); max-width: 380px; aspect-ratio: 3/4; object-fit: cover; object-position: center 15%; box-shadow: 0 12px 40px rgba(0,0,0,0.08);" loading="lazy" decoding="async">
      </div>
    </div>
  </div>
</section>

<!-- ========== CTA ========== -->
<section class="cta-section">
  <div class="container" data-reveal>
    <span class="section-label">Tag første skridt</span>
    <h2>Klar til at finde din vej?</h2>
    <p>Der er ingen forkerte tidspunkter at tage det første skridt. Ring <a href="tel:{{ site.phoneE164 }}" style="color: var(--gold); text-decoration: none; font-weight: 600;">{{ site.phone }}</a> eller skriv — jeg vender tilbage hurtigst muligt.</p>
    <div class="cta-buttons">
      <a href="/kontakt/" class="btn btn-gold">Book en samtale</a>
      <a href="/kontakt/" class="btn btn-teal">Kontakt mig</a>
    </div>
  </div>
</section>
